{
  "name": "claude-antislop",
  "version": "0.1.0",
  "description": "Local-first, per-developer quality layer that never touches your repo config",
  "type": "module",
  "bin": {
    "claude-antislop": "./cli/index.mjs"
  },
  "scripts": {
    "start": "node cli/index.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint cli/ tests/ --ext .mjs,.js",
    "lint:fix": "eslint cli/ tests/ --ext .mjs,.js --fix",
    "format": "prettier --write \"cli/**/*.mjs\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"cli/**/*.mjs\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "check": "npm run lint && npm run format:check && npm test",
    "release": "npx semantic-release",
    "release:dry": "npx semantic-release --dry-run"
  },
  "keywords": [
    "code-quality",
    "developer-tools",
    "cli",
    "memory",
    "standards",
    "patterns"
  ],
  "author": "mednabouli",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "chokidar": "^3.5.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "semantic-release": "^23.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
