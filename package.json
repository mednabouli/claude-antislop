{
  "name": "claude-antislop",
  "version": "1.0.0",
  "description": "Local-first, per-developer quality layer that never touches your repo config",
  "type": "module",
  "main": "cli/index.mjs",
  "bin": {
    "claude-antislop": "./cli/index.mjs"
  },
  "scripts": {
    "start": "node cli/index.mjs",
    "dev": "node --watch cli/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "lint": "eslint cli/ mcp/ tests/",
    "typecheck": "tsc --noEmit",
    "build": "echo 'ESM - no build step needed'",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "claude",
    "code-quality",
    "mcp",
    "developer-tools",
    "cli",
    "local-first"
  ],
  "author": "Med (@mednabouli)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mednabouli/claude-antislop.git"
  },
  "bugs": {
    "url": "https://github.com/mednabouli/claude-antislop/issues"
  },
  "homepage": "https://github.com/mednabouli/claude-antislop#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
