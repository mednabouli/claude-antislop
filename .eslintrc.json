{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-unused-expressions": "error",
    "no-implicit-coercion": "error",
    "max-params": ["warn", 4],
    "max-statements": ["warn", 50],
    "complexity": ["warn", 10]
  },
  "ignorePatterns": ["node_modules/", "dist/", "coverage/", "*.test.js"]
}
