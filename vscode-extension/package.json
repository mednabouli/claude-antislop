{
  "name": "claude-antislop-vscode",
  "displayName": "Claude Anti-Slop",
  "description": "Local-first code-quality memory and checks in VS Code",
  "version": "0.1.0",
  "publisher": "mednabouli",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Linters", "Other", "Testing"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {"command": "claudeAntislop.runWizard", "title": "Claude Anti-Slop: Run Setup Wizard"},
      {"command": "claudeAntislop.showStatus", "title": "Claude Anti-Slop: Show Status"},
      {"command": "claudeAntislop.scanWorkspace", "title": "Claude Anti-Slop: Scan Workspace"},
      {"command": "claudeAntislop.searchMemory", "title": "Claude Anti-Slop: Search Memory"},
      {"command": "claudeAntislop.checkSelection", "title": "Claude Anti-Slop: Check Selection"}
    ],
    "configuration": {
      "title": "Claude Anti-Slop",
      "properties": {
        "claudeAntislop.cliPath": {"type": "string", "default": "claude-antislop", "description": "Path to CLI"},
        "claudeAntislop.enableDiagnostics": {"type": "boolean", "default": true, "description": "Enable diagnostics"},
        "claudeAntislop.locale": {"type": "string", "default": "", "enum": ["", "en", "fr", "es", "de", "zh", "ja"], "description": "Locale"}
      }
    },
    "menus": {"commandPalette": [{"command": "claudeAntislop.checkSelection", "when": "editorTextFocus"}]}
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mednabouli/claude-antislop"
  },
  "bugs": {
    "url": "https://github.com/mednabouli/claude-antislop/issues"
  },
  "homepage": "https://github.com/mednabouli/claude-antislop#readme"
}
